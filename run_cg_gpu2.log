    for row in maze:
        for cell in row:
            if cell == 'P':
                print('P', end=' ')
            elif cell == 'E':
                print('E', end=' ')
            elif cell == ' ':
                print(' ', end=' ')
            elif cell == '#':
                print('#', end=' ')
        print()

