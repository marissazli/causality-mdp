### 📄 `utils.py`

```python
import subprocess

def check_network(hostname):
    """
    Checks if a hostname is reachable by pinging it.
    Returns True if the host is reachable, False otherwise.
    """
    try:
        # Use the system's ping command
        result = subprocess.run(
            ["ping", "-c", "1", hostname],  # -c 1 sends 1 packet
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=5  # Timeout after 5 seconds
        )
        if result.returncode == 0:
            print(f"✅ {hostname} is reachable.")
            return True
        else:
            print(f"❌ {hostname} is not reachable.")
            return False
    except subprocess.CalledProcessError as e:
        print(f"⚠️ Error pinging {hostname}: {e}")
        return False
    except Exception as e:
        print(f"⚠️ An unexpected error occurred: {e}")
        return False
