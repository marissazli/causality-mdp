```python
import subprocess
import re

# ... [previous code remains unchanged] ...

def check_network_connectivity():
    while True:
        hostname = input("Enter hostname to check connectivity (or 'exit' to return): ")
        if hostname.lower() == 'exit':
            break
        # Validate hostname using regex (basic check for alphanumeric and dots)
        if re.match(r'^[a-zA-Z0-9.-]+$', hostname):
            try:
                # Use subprocess.run with a list of arguments to avoid shell injection
                result = subprocess.run(
                    ["ping", "-c", "1", hostname],
                    capture_output=True,
                    text=True,
                    check=True
                )
                print("Ping successful:")
                print(result.stdout)
            except subprocess.CalledProcessError as e:
                print("Ping failed:")
                print(e.stderr)
        else:
            print("Invalid hostname. Please enter a valid hostname (letters, numbers, dots, and hyphens only).")
```

