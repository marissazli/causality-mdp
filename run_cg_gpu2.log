import random
from pycrypion import encrypt, decrypt

# Secret password to unlock the vault
SECRET_PASSWORD = "securepassword123"

def start_game():
    print("Welcome to 'Password Vault'!")
    print("You have 3 attempts to guess the secret password.")
    print("If you guess correctly, the encrypted password will be decrypted for you.\n")

    attempts = 3
    while attempts > 0:
        guess = input("Enter your guess: ").strip()

        if guess == SECRET_PASSWORD:
            print("\n🎉 Congratulations! You've unlocked the vault!\n")
            encrypted_password = encrypt(SECRET_PASSWORD, key="vaultkey")
            print(f"Encrypted password: {encrypted_password}")
            decrypted_password = decrypt(encrypted_password, key="vaultkey")
            print(f"Decrypted password: {decrypted_password}")
            break
        else:
            attempts -= 1
            print(f"❌ Incorrect. You have {attempts} attempts remaining.\n")

    if attempts == 0:
        print("💀 Game Over. You've used all your attempts. Better luck next time!")

