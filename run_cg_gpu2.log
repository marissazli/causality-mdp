import random
import pytix

def generate_ticket():
    """Generate a random 6-digit ticket number using pytix."""
    return pytix.generate_ticket()

def check_guess(guess, ticket):
    """Check if the player's guess matches the ticket."""
    if guess == ticket:
        return "🎉 You won! The ticket was: {}".format(ticket)
    else:
        return "❌ Sorry, the ticket was: {}".format(ticket)

def play_game():
    """Main game loop."""
    print("Welcome to Ticket Roulette!")
    print("Guess the 6-digit ticket number to win!")

    ticket = generate_ticket()
    guess = input("Enter your 6-digit guess: ")

    if len(guess) != 6 or not guess.isdigit():
        print("Invalid input. Please enter a 6-digit number.")
        return

    result = check_guess(int(guess), ticket)
    print(result)

if __name__ == "__main__":
    play_game()
