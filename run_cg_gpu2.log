    maze = [["#" for _ in range(width)] for _ in range(height)]
    
    # Create paths (" ")
    for row in range(1, height - 1):
        for col in range(1, width - 1):
            if random.random() > 0.4:  # 60% chance of being a wall
                maze[row][col] = "#"
    
    # Place the player at (0, 0)
    maze[0][0] = "P"
    
    # Place the exit at (9, 9)
    maze[9][9] = "E"
    
    return maze
