# Game class to encapsulate state
class Game:
    def __init__(self):
        self.score = 0
        self.time_left = 60  # 60 seconds
        self.current_color = None
        self.game_over = False

    def start_game(self):
        self.score = 0
        self.time_left = 60
        self.current_color = self._generate_random_color()
        self.game_over = False
        return self

    def _generate_random_color(self):
        colors = ["red", "blue", "green", "yellow", "purple", "orange"]
        return random.choice(colors)

    def check_match(self, selected_color):
        if selected_color == self.current_color:
            self.score += 1
            self.current_color = self._generate_random_color()
        else:
            self.time_left -= 5  # Penalize for incorrect match
        return self

