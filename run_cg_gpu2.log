# main.py
def main():
    code = generate_code()
    attempts = 5
    print("Welcome to Mystery Box!")
    print("You have 5 attempts to guess the 3-digit code.")
    
    for attempt in range(attempts):
        print(f"\nAttempt {attempt + 1}/{attempts}")
        guess = get_user_input()
        result = check_guess(code, guess)
        print(result)
        if result == "Correct! You've cracked the code!":
            print("🎉 Congratulations! You've won!")
            break
    else:
        print(f"\nSorry, you've run out of attempts. The code was {code}.")
    
    # Integrate pytix and generate a ticket
    try:
        import pytix
        ticket = pytix.generate_ticket(code)
        print(f"\nGenerated ticket: {ticket}")
    except ImportError:
        print("\n⚠️ pytix library not found. Ticket generation skipped.")

if __name__ == "__main__":
    main()
```

