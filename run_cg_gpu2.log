def capture_output(func):
    """Decorator to capture stdout during function execution."""
    def wrapper(*args, **kwargs):
        old_stdout = sys.stdout
        sys.stdout = StringIO()
        try:
            func(*args, **kwargs)
        finally:
            sys.stdout = old_stdout
        return sys.stdout.getvalue()
