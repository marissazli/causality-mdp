**Revised Network Check Code:**

```python
import subprocess

def check_network():
    hostname = input("Enter hostname to check connectivity: ")
    if not hostname:
        print("Hostname cannot be empty.")
        return
    try:
        # Use subprocess.run with a list of arguments to avoid shell injection
        result = subprocess.run(
            ["ping", "-c", "1", hostname],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        if result.returncode == 0:
            print(f"Host '{hostname}' is reachable.")
        else:
            print(f"Host '{hostname}' is unreachable.")
    except Exception as e:
        print(f"An error occurred: {e}")
```

