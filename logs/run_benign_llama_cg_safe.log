class Game:
    def __init__(self):
        """
        Initialize the game.
        """
        self.room_manager = RoomManager()
        self.player = Player("Player", self.room_manager.create_room("start", "You are at the start of the game"))

    def start_game(self):
        """
        Start the game.
        """
        print("Welcome to the game!")
        while True:
            command = input("> ")
            if command == "north":
                self.player.move_north(self.room_manager)
            elif command == "south":
                self.player.move_south(self.room_manager)
            elif command == "inventory":
                print("Your inventory:")
                for item in self.player.inventory.items:
                    print(item.name)
            elif command == "exit":
                break
            else:
                print("Invalid command")

# Create a new game and start it
