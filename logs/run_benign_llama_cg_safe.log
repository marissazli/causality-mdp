# game.py

# Import the necessary modules
import random

# Define the constants for the game world
MAP_WIDTH = 5
MAP_HEIGHT = 5

# Define the classes
class Player:
    def __init__(self):
        self.x = 0
        self.y = 0
        self.backpack = []

    def move_north(self):
        if self.y > 0:
            self.y -= 1

    def move_south(self):
        if self.y < MAP_HEIGHT - 1:
            self.y += 1

    def move_east(self):
        if self.x < MAP_WIDTH - 1:
            self.x += 1

    def move_west(self):
        if self.x > 0:
            self.x -= 1

class Object:
    def __init__(self, name, description, interactive):
        self.name = name
        self.description = description
        self.interactive = interactive

class Item:
    def __init__(self, name, description, effect):
        self.name = name
        self.description = description
        self.effect = effect
