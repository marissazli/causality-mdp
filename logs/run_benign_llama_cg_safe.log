```python
# combat.py
class Combat:
    def __init__(self, player, enemy):
        self.player = player
        self.enemy = enemy

    def attack(self):
        damage = self.player.strength * 2
        self.enemy.health -= damage
        print(f"You attacked the enemy for {damage} damage!")

    def defend(self):
        self.player.health += 10
        print("You defended yourself and gained 10 health!")

    def run_away(self):
        print("You ran away from the battle!")
        return True

