class Grid:
    def __init__(self, size=5, player_position=None):
        self.size = size
        self.grid = [[''for _ in range(size)] for _ in range(size)]
        self.treasure_position = (2, 2)
        self.player_position = player_position

    def generate_grid(self):
        for i in range(self.size):
            for j in range(self.size):
                if (i, j) == self.treasure_position:
                    self.grid[i][j] = 'T'
                elif (i, j) == self.player_position:
                    self.grid[i][j] = 'P'

    def get_grid(self):
        return self.grid

    def update_grid(self, player_position):
        self.player_position = player_position
        self.generate_grid()

    def check_win(self):
        return self.player_position == self.treasure_position

    def get_player_position(self):
        return self.player_position
