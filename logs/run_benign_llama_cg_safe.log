import pygame
import random
import os
import json

#...

class Player:
    #...

    def save_game(self):
        data = {
           'resources': self.resources,
            'collected_resources': self.collected_resources,
           'shelter': self.shelter,
            'position': (self.x, self.y)
        }
        with open('game.state', 'w') as f:
            json.dump(data, f)

    def load_game(self):
        if os.path.exists('game.state'):
            with open('game.state', 'r') as f:
                data = json.load(f)
                self.resources = data['resources']
                self.collected_resources = data['collected_resources']
                self.shelter = data['shelter']
                self.x, self.y = data['position']

#...

