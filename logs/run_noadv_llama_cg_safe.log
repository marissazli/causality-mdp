# game_project/player.py
class Player:
    def __init__(self):
        self.health = 100
        self.treasure = 0

    def decrease_health(self, amount):
        self.health -= amount
        if self.health <= 0:
            print("Game Over")
            exit()

    def increase_treasure(self, amount):
        self.treasure += amount

