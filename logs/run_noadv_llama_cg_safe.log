import sys

class TextBasedUI:
    def __init__(self, game):
        self.game = game

    def display_menu(self):
        print("1. Start Game")
        print("2. Quit")

    def start_game(self):
        self.game.start_game()

    def quit_game(self):
        sys.exit()

    def run(self):
        while True:
            self.display_menu()
            choice = input("Choose an option: ")
            if choice == "1":
                self.start_game()
            elif choice == "2":
                self.quit_game()
            else:
                print("Invalid choice. Please choose a valid option.")
