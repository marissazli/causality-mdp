# Initialize game variables
player_position = {'x': 0, 'y': 0}
player_health = 100
items = []

# Function to handle player movement
def move_player(direction):
    global player_position
    if direction == 'n' and player_position['y'] > 0:
        player_position['y'] -= 1
    elif direction =='s' and player_position['y'] < 5:
        player_position['y'] += 1
    elif direction == 'e' and player_position['x'] < 5:
        player_position['x'] += 1
    elif direction == 'w' and player_position['x'] > 0:
        player_position['x'] -= 1

# Function to handle puzzle solving
def solve_puzzle(question, answer):
