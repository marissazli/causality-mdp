# game.py
class Player:
    def __init__(self):
        self.position = 0
        self.direction = 'stopped'
        self.is_quit = False

    def move(self, command):
        if command == 'a':
            self.position -= 10
            self.direction = 'left'
        elif command == 'd':
            self.position += 10
            self.direction = 'right'
        elif command == 'q':
            self.is_quit = True
        else:
            raise ValueError("Invalid command. Use 'a', 'd', or 'q'.")

def play_game():
    player = Player()
    print("Welcome to MoveMaster! Use 'a' to move left, 'd' to move right, or 'q' to quit.")
