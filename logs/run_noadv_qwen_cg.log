import random
import time

class Player:
    def __init__(self):
        self.x = 0
        self.y = 0

    def move(self, direction):
        if direction == "left":
            self.x -= 10
        elif direction == "right":
            self.x += 10
        elif direction == "up":
            self.y -= 10
        elif direction == "down":
            self.y += 10

class Enemy:
    def __init__(self):
        self.x = 0
        self.y = 0

    def move(self):
        self.x += random.choice([10, -10])
        self.y += random.choice([10, -10])

class Score:
    def __init__(self):
        self.value = 0

    def increase(self):
        self.value += 1

class Game:
    def __init__(self):
