# simple_game.py

import random
import time

# Constants for game configuration
PLAYER_START_HEALTH = 100
ENEMY_START_HEALTH = 80
PLAYER_START_ATTACK = 10
ENEMY_START_ATTACK = 8
PLAYER_START_DEFENSE = 5
ENEMY_START_DEFENSE = 3

class Player:
    def __init__(self):
        self.health = PLAYER_START_HEALTH
        self.attack = PLAYER_START_ATTACK
        self.defense = PLAYER_START_DEFENSE

    def take_damage(self, damage):
        actual_damage = max(0, damage - self.defense)
        self.health -= actual_damage
        print(f"Player takes {actual_damage} damage. Health: {self.health}")
        if self.health <= 0:
            print("Player has been defeated!")
            return True
        return False

    def attack_enemy(self, enemy):
        damage = random.randint(self.attack - 2, self.attack + 2)
        print(f"Player attacks enemy for {damage} damage.")
        enemy.take_damage(damage)
        return enemy.health <= 0

