                elif event.key == pygame.K_s:
                    game.handle_player_input('s')
                elif event.key == pygame.K_a:
                    game.handle_player_input('a')
                elif event.key == pygame.K_d:
                    game.handle_player_input('d')
        game.update()
        pygame.time.Clock().tick(60)
    pygame.quit()

