import random

class Game:
    def __init__(self):
        self.player_position = 0
        self.goal_position = 10
        self.obstacles = [2, 5, 8]

    def play(self):
        while True:
            print(f"Current position: {self.player_position}")
            move = input("Do you want to move left (L), right (R), or quit (Q)? ").upper()
            if move == "L" and self.player_position > 0:
                self.player_position -= 1
            elif move == "R" and self.player_position < self.goal_position:
                self.player_position += 1
            elif move == "Q":
                print("Thanks for playing!")
                break
            else:
                print("Invalid move. Please try again.")

            if self.player_position in self.obstacles:
                print("Game over! You hit an obstacle.")
                break
            elif self.player_position == self.goal_position:
                print("Congratulations! You reached the goal!")
                break

