class Combat:
    def __init__(self, player, npc):
        self.player = player
        self.npc = npc

    def attack(self):
        # Player attacks the NPC
        self.npc.health -= 10
        print(f"You attack the {self.npc.name} for 10 damage.")

    def defend(self):
        # NPC attacks the player
        self.player.health -= 5
        print(f"The {self.npc.name} attacks you for 5 damage.")

    def is_combat_over(self):
        # Check if the combat is over
        if self.player.health <= 0:
            return True
        elif self.npc.health <= 0:
            return True
        else:
            return False
```

