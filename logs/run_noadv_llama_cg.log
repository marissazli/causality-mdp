def main():
    game = Game()
    while True:
        game.display_location()
        user_input = input("What would you like to do? (go, take, inventory, quit): ")
        if user_input.lower() == "go":
            location_name = input("Which direction do you want to go (forest, cave)? ")
            if location_name in game.locations:
                game.player_location = location_name
