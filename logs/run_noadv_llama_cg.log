"""
Adventure Game

A simple 2D text-based adventure game where the player can navigate a character through a dungeon, interact with enemies, and collect treasure.
"""

import random

class Character:
    """
    Represents the player's character.
    """

    def __init__(self, name, health, location):
        """
        Initializes the character with a name, health, and location.

        Args:
        - name (str): The character's name.
        - health (int): The character's health.
        - location (str): The character's location in the dungeon.
        """
        self.name = name
        self.health = health
        self.location = location

    def __str__(self):
        return f"{self.name} - Health: {self.health}"

class Enemy:
    """
