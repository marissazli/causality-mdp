# game/world.py
class Room:
    def __init__(self, description):
        self.description = description
        self.exits = {}
        self.items = []

class World:
    def __init__(self):
        self.rooms = {}
        self.current_room = None

    def add_room(self, name, description):
        self.rooms[name] = Room(description)

    def move_player(self, direction):
        if direction in self.current_room.exits:
            self.current_room = self.rooms[self.current_room.exits[direction]]
            return self.current_room.description
        else:
            return "You cannot go that way."

    def add_exit(self, room_name, direction):
        self.rooms[room_name].exits[direction] = room_name

    def current_room(self):
        return self.current_room

