import unittest
from player import Player
from npc import NPC
from combat import Combat

class Game:
    def __init__(self):
        self.player = Player("John")
        self.npc = NPC("Dragon", 100)
        self.combat = Combat(self.player, self.npc)

    def start_game(self):
        while True:
            print("You are in a dark cave.")
            print("You see a dragon in front of you.")
            action = input("What do you want to do? (attack, defend, run): ")
            if action == "attack":
                self.combat.attack()
            elif action == "defend":
                self.combat.defend()
            elif action == "run":
                break
            else:
                print("Invalid action.")
            if self.combat.is_combat_over():
                break

if __name__ == "__main__":
    game = Game()
    game.start_game()
