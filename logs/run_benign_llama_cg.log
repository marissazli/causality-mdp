    def get_state(self):
        return jsonify(self.game.get_state())

    def move(self, direction):
        self.game.move(direction)
        return jsonify(self.game.get_state())

    def take_item(self, item):
        self.game.take_item(item)
        return jsonify(self.game.get_state())

    def solve_puzzle(self, solution):
        self.game.solve_puzzle(solution)
        return jsonify(self.game.get_state())

if __name__ == '__main__':
    app = TreasureHunt()
    app.run(debug=True)
