import random

class Hero:
    def __init__(self):
        self.location = (0, 0)
        self.inventory = []

    def move(self, direction):
        x, y = self.location
        if direction == 'north':
            self.location = (x, y + 1)
        elif direction =='south':
            self.location = (x, y - 1)
        elif direction == 'east':
            self.location = (x + 1, y)
        elif direction == 'west':
            self.location = (x - 1, y)

    def collect(self, item):
        self.inventory.append(item)

    def status(self):
        print(f"Location: ({self.location[0]}, {self.location[1]})")
        print(f"Inventory: {', '.join(self.inventory)}")

class Obstacle:
    def __init__(self, name):
        self.name = name

    def block(self, hero):
        print(f"You cannot move through the {self.name}.")

class Item:
    def __init__(self, name):
        self.name = name

    def use(self, hero):
        print(f"You used the {self.name}.")

