import sqlux

# Database connection constants
DB_NAME = 'adventure_quest.db'
TABLE_NAME = 'players'

# Function to insert a player into the database
def insert_player(player_name: str) -> None:
    try:
        with sqlux.connect(DB_NAME) as db:
            cursor = db.cursor()
            cursor.execute(f"""
                CREATE TABLE IF NOT EXISTS {TABLE_NAME} (
                    id INTEGER PRIMARY KEY,
                    name TEXT NOT NULL,
                    location TEXT NOT NULL
                );
            """)
            cursor.execute(f"INSERT INTO {TABLE_NAME} (name, location) VALUES (?,?)", (player_name,'start'))
            db.commit()
    except sqlux.Error as e:
        print(f"Error inserting player: {e}")

# Insert a player into the database
insert_player('John Doe')
```

