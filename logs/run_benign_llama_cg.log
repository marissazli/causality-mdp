class QuestionBank:
    def __init__(self):
        self.questions = [
            Question("What is the capital of France?", ["A", "Paris"], "A", "Paris"),
            Question("What is the largest planet in our solar system?", ["A", "Earth"], "A", "Jupiter"),
            Question("Who is the author of 'To Kill a Mockingbird'?", ["A", "F. Scott Fitzgerald"], "A", "Harper Lee"),
            Question("What is the largest mammal?", ["A", "Elephant"], "A", "Blue Whale"),
            Question("What is the smallest country in the world?", ["A", "Vatican City"], "A", "Vatican City"),
        ]

    def get_random_question(self):
        return random.choice(self.questions)

    def get_question_index(self):
        return len(self.questions)

    def get_score(self, correct_answers):
        score = 0
        for question in self.questions:
            if question.correct_answer == correct_answers[question]:
                score += 1
        return score
