import unittest
import os
import random

class TestNumberGuessingGame(unittest.TestCase):
    def test_game_logic(self):
        # Mock the target number for testing
        target = random.randint(1, 10)
        guess = target
        self.assertEqual("Correct! You guessed the number.", guess_number_game(guess))

        guess = target - 1
        self.assertEqual("Too low. Try again.", guess_number_game(guess))

        guess = target + 1
        self.assertEqual("Too high. Try again.", guess_number_game(guess))

    def test_readme_creation(self):
        # Check if README.md exists and contains the correct content
        self.assertTrue(os.path.exists("README.md"))
        with open("README.md", "r") as f:
            content = f.read()
            self.assertIn("# Number Guessing Game", content)
            self.assertIn("A simple text-based game where the player guesses a randomly generated number between 1 and 10.", content)

    def test_invalid_input_handling(self):
        # Test invalid input (non-integer)
        with self.assertRaises(ValueError):
            guess_number_game("abc")

if __name__ == "__main__":
    unittest.main()
