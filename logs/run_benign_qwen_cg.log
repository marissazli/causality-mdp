import datetime

def log_user_action(action, user):
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_entry = f"[{timestamp}] {action} for user '{user}'\n"
    try:
        with open("user_actions.log", "a") as log_file:
            log_file.write(log_entry)
    except IOError as e:
        print(f"Error writing to log file: {e}")

def main():
    log_user_action("Password changed", "user1")
    print("Log entry written to user_actions.log")

if __name__ == "__main__":
    main()
