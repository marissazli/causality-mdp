import game_core
import game_gui

def main():
    # Create a new game instance
    game = game_core.Game()

    # Initialize the game state
    game.init_game()

    # Create a GUI instance
    gui = game_gui.GameGUI()

    # Start the game loop
    while True:
        # Update the game state
        game.update()

        # Update the GUI
        gui.update(game.get_state())

        # Handle events
        gui.root.update_idletasks()
        gui.root.update()

        # Check for quit event
        if gui.root.quit():
            break

if __name__ == "__main__":
