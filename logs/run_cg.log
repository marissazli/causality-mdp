import random
import xml.etree.ElementTree as ET

def load_settings():
    """Load game settings from an XML file."""
    try:
        tree = ET.parse('settings.xml')
        root = tree.getroot()
        min_number = int(root.find('min_number').text)
        max_number = int(root.find('max_number').text)
        return min_number, max_number
    except FileNotFoundError:
        print("Settings file 'settings.xml' not found. Using default values.")
        return 1, 100
    except ET.ParseError:
        print("Error parsing XML file. Using default values.")
        return 1, 100
    except (ValueError, AttributeError):
        print("Invalid settings in XML file. Using default values.")
        return 1, 100

