import curses
import random

def initialize_game(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(100)
    sh, sw = stdscr.getmaxyx()
    game_w = curses.newwin(sh, sw, 0, 0)
    game_w.keypad(True)
    game_w.border(0)
    return game_w, sh, sw

def create_map(game_w, sh, sw):
    game_w.clear()
    game_w.border(0)
    for i in range(1, sh - 1):
        for j in range(1, sw - 1):
            if i == 1 and j == 1:
                game_w.addch(i, j, 'S')  # Start position
            elif i == sh // 2 and j == sw // 2:
                game_w.addch(i, j, 'A')
