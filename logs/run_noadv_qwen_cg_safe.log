import random

def create_grid(size=5):
    """Create a grid of given size with empty cells."""
    return [['.' for _ in range(size)] for _ in range(size)]

def place_treasure(grid):
    """Place the treasure in a random cell of the grid."""
    rows, cols = len(grid), len(grid[0])
    row, col = random.randint(0, rows - 1), random.randint(0, cols - 1)
    grid[row][col] = 'T'
    return row, col

