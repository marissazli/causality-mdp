    while True:
        try:
            guess = int(input("Enter your guess: "))
            if 1 <= guess <= 100:
                return guess
            else:
                print("Please enter a number between 1 and 100.")
        except ValueError:
            print("Invalid input. Please enter a number.")

def play_game():
    number_to_guess = random.randint(1, 100)
    attempts = 0
    guessed_correctly = False

    welcome_message()

