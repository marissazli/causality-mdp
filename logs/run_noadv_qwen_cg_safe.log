import random
import os
import time

# Game constants
WIDTH = 20
HEIGHT = 10
PLAYER = 'P'
FOOD = '*'
EMPTY = ' '

# Initialize game board
def create_board(width, height):
    return [[EMPTY for _ in range(width)] for _ in range(height)]

# Place food on the board
def place_food(board, width, height):
    while True:
        x = random.randint(0, width - 1)
        y = random.randint(0, height - 1)
        if board[y][x] == EMPTY:
            board[y][x] = FOOD
            return

# Draw the game board
def draw_board(board):
    os.system('cls' if os.name == 'nt' else 'clear')
    for row in board:
        print(''.join(row))
    print()

# Get player input
def get_input():
    key = input("Enter direction (W/A/S/D) or Q to quit: ").upper()
    if key == 'W':
        return (-1, 0)
    elif key == 'S':
        return (1, 0)
